{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "codex-observational-memory hook --event SessionStart",
            "statusMessage": "Loading observational memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex-observational-memory hook --event UserPromptSubmit",
            "statusMessage": "Injecting observational memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex-observational-memory hook --event Stop",
            "statusMessage": "Recording observational memory",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "codex-observational-memory hook --event PreCompact",
            "statusMessage": "Preparing observational memory"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "codex-observational-memory hook --event PostCompact",
            "statusMessage": "Scheduling observational memory injection"
          }
        ]
      }
    ]
  }
}
